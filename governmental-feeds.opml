<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Governmental RSS Feeds - Federal Agencies</title>
    <dateCreated>2026-01-14T00:00:00Z</dateCreated>
    <dateModified>2026-01-14T00:00:00Z</dateModified>
    <ownerName>Personal Government Feed Tracker</ownerName>
    <ownerEmail>admin@localhost</ownerEmail>
    <docs>http://opml.org/spec2.opml.html</docs>
  </head>
  <body>
    <!-- LEGISLATIVE FEEDS -->
    <outline text="Legislative" title="Legislative Branch">
      <outline text="Congress.gov" title="Congress.gov - Bill Status" xmlUrl="https://www.congress.gov/rss/House.xml" type="rss"/>
      <outline text="Senate.gov News" title="U.S. Senate News &amp; Press" xmlUrl="https://www.senate.gov/rss/all_releases.xml" type="rss"/>
      <outline text="House.gov News" title="U.S. House of Representatives News" xmlUrl="https://www.house.gov/rss.xml" type="rss"/>
    </outline>

    <!-- WHITE HOUSE -->
    <outline text="Executive Office" title="Executive Branch">
      <outline text="White House Briefing Room" title="White House Press Releases" xmlUrl="https://www.whitehouse.gov/feed/" type="rss"/>
      <outline text="OMB Memoranda" title="Office of Management &amp; Budget" xmlUrl="https://www.whitehouse.gov/omb/information-regulatory-affairs/memoranda/" type="rss"/>
    </outline>

    <!-- FEDERAL REGISTER -->
    <outline text="Federal Register" title="Federal Register &amp; Regulations">
      <outline text="Federal Register Updates" title="Federal Register Daily Updates" xmlUrl="https://www.federalregister.gov/rss/feed.xml" type="rss"/>
    </outline>

